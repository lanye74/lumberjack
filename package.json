{
	"name": "lumberjack",
	"version": "2.6.0",
	"description": "Log where you are, instantly",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview --host 0.0.0.0 --port 443",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"gen-supabase-types": "npx supabase gen types --lang=typescript --project-id \"gikuvqhvhuuooyegmotc\" --schema public > src/lib/types/supabase.ts"
	},
	"devDependencies": {
		"@sveltejs/adapter-node": "^5.2.12",
		"@sveltejs/kit": "^2.17.3",
		"@sveltejs/vite-plugin-svelte": "^5.0.3",
		"rollup-plugin-visualizer": "^5.14.0",
		"supabase": "^2.15.8",
		"svelte": "^5.20.4",
		"svelte-check": "^4.1.4",
		"tslib": "^2.8.1",
		"typescript": "^5.7.3",
		"vite": "^6.2.0"
	},
	"dependencies": {
		"@iconify-json/fa-regular": "^1.2.1",
		"@iconify-json/fa-solid": "^1.2.1",
		"@supabase/ssr": "^0.5.2",
		"@supabase/supabase-js": "^2.49.1",
		"@vite-pwa/sveltekit": "^0.6.7",
		"fast-glob": "^3.3.3",
		"skia-canvas": "^2.0.2",
		"unplugin-icons": "^22.1.0"
	}
}
