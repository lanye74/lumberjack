{
	"name": "lumberjack",
	"version": "2.6.0",
	"description": "Log where you are, instantly",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview --host 0.0.0.0 --port 443",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"gen-supabase-types": "npx supabase gen types --lang=typescript --project-id \"gikuvqhvhuuooyegmotc\" --schema public > src/lib/types/supabase.ts"
	},
	"devDependencies": {
		"@sveltejs/adapter-node": "^5.3.1",
		"@sveltejs/kit": "^2.37.0",
		"@sveltejs/vite-plugin-svelte": "^6.1.4",
		"rollup-plugin-visualizer": "^6.0.3",
		"supabase": "^2.39.2",
		"svelte": "^5.38.7",
		"svelte-check": "^4.3.1",
		"tslib": "^2.8.1",
		"typescript": "^5.9.2",
		"vite": "^7.1.4"
	},
	"dependencies": {
		"@fontsource-variable/cascadia-mono": "^5.2.1",
		"@fontsource-variable/lora": "^5.2.6",
		"@iconify-json/fa-regular": "^1.2.2",
		"@iconify-json/fa-solid": "^1.2.2",
		"@supabase/ssr": "^0.7.0",
		"@supabase/supabase-js": "^2.57.2",
		"@vite-pwa/sveltekit": "^1.0.0",
		"fast-glob": "^3.3.3",
		"skia-canvas": "^3.0.6",
		"unplugin-icons": "^22.2.0"
	}
}
